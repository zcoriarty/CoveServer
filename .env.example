# CoveServer Environment Configuration
# Copy to .env and fill in production values

# PostgreSQL
POSTGRES_PASSWORD=change-me-in-production

# JWT
JWT_SECRET=change-me-in-production-use-64-random-hex-chars

# MinIO / S3
MINIO_ROOT_USER=cove
MINIO_ROOT_PASSWORD=change-me-in-production

# Redis (leave empty to disable auth for local dev)
REDIS_PASSWORD=
