# CoveServer Environment Configuration
# Copy to .env and fill in production values.

# PostgreSQL (Supabase recommended)
DATABASE_URL=postgresql://postgres:replace-me@db.your-project-ref.supabase.co:5432/postgres
# Optional SQLx pool sizing (useful for Supabase Session mode poolers)
COVE_DATABASE__MAX_CONNECTIONS=5
COVE_DATABASE__MIN_CONNECTIONS=0

# Supabase Storage (required)
SUPABASE_STORAGE_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_BUCKET=media
SUPABASE_SECRET_KEY=replace-me

# Redis (Railway Redis or external)
REDIS_URL=redis://127.0.0.1:6379/

# JWT
JWT_SECRET=change-me-in-production-use-64-random-hex-chars

# Server port (Railway injects PORT automatically)
PORT=50051

# Push notifications (optional)
COVE_PUSH__ENABLED=false
COVE_PUSH__APNS_KEY_ID=
COVE_PUSH__APNS_TEAM_ID=
COVE_PUSH__APNS_BUNDLE_ID=
COVE_PUSH__APNS_PRIVATE_KEY_PATH=./secrets/AuthKey.p8
COVE_PUSH__DEFAULT_ENVIRONMENT=development
